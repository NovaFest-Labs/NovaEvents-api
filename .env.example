# Network passphrase to sign simulated transactions with. Must match the
# network STELLAR_RPC_URL points at. Defaults to the testnet passphrase
# when unset — only needed if you point STELLAR_RPC_URL somewhere else
# (mainnet, futurenet, a local sandbox).
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ---------------------------------------------------------------------------
# Image upload (POST /api/events/:id/image)
# ---------------------------------------------------------------------------
# S3-compatible object storage credentials.
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
#
# Required:
S3_BUCKET_NAME=novaevents-images
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
#
# Optional — set S3_REGION to your bucket region (default: auto):
# S3_REGION=us-east-1
#
# Optional — set S3_ENDPOINT for non-AWS providers (Cloudflare R2, MinIO, etc.).
# Leave unset to use AWS S3.
# Examples:
#   Cloudflare R2  : https://<account-id>.r2.cloudflarestorage.com
#   MinIO (local)  : http://localhost:9000
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
